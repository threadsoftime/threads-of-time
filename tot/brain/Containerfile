FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY brain_sidecar ./brain_sidecar
COPY prompts ./prompts
COPY migrations ./migrations

ENV BRAIN_BIND_HOST=0.0.0.0 \
    BRAIN_BIND_PORT=8091 \
    BRAIN_STATE_DB=/var/lib/brain/state.sqlite \
    BRAIN_DECISIONS_LOG=/var/log/brain/decisions.jsonl

EXPOSE 8091

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -fsS http://localhost:8091/healthz || exit 1

CMD ["python", "-m", "brain_sidecar"]
