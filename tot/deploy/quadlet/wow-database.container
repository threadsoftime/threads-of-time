[Unit]
Description=Threads of Time database (MySQL 8.x)
Requires=tot-server-pod.service
After=tot-server-pod.service

[Container]
ContainerName=tot-database
Image=docker.io/library/mysql:8.4
Pod=tot-server.pod
Volume=tot-database.volume:/var/lib/mysql:Z
EnvironmentFile=@TOT_HOME@/.env
Environment=MYSQL_DATABASE=tot_world
# $$ becomes a literal $ after systemd→podman ExecStart quoting; the container shell expands MYSQL_ROOT_PASSWORD.
# Verify on Linux/Tier-2: Quadlet $$→$ escaping is macOS-unverifiable (no Quadlet generator locally).
HealthCmd=/bin/sh -c "mysqladmin ping -h 127.0.0.1 -uroot -p$$MYSQL_ROOT_PASSWORD --silent"
HealthInterval=10s
HealthTimeout=5s
HealthRetries=10

[Service]
Restart=on-failure
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target default.target
