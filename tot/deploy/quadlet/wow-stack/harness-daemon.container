# /etc/containers/systemd/wow-stack/harness-daemon.container
# Symlinked into /etc/containers/systemd/ on Heimdal.

[Unit]
Description=Heimdal agentic harness daemon
After=wow-worldserver.service
Wants=wow-worldserver.service

[Container]
Image=localhost/harness-daemon:current
ContainerName=harness-daemon
Pod=wow-server.pod

Volume=/opt/containers/wow/etc/harness:/etc/harness:z,ro
Volume=/opt/containers/wow/logs/harness:/var/log/harness:z
EnvironmentFile=/opt/containers/wow/etc/harness/mysql.env
Exec=serve --config /etc/harness/tokens.yaml

# Resource budget (kb_adbafeda): daemon stays light on the gaming PC.
PodmanArgs=--memory=200m --cpus=0.5

# Network: pod-shared with wow-worldserver — daemon reaches AC bridge
# at 127.0.0.1:8091 via the pod's loopback. External listener at 8099.
# Port 8090 is taken by memory-sidecar; port publishing lives on the pod.
# NOTE: Port publishing must live on the pod (wow-server.pod) not the container.

[Service]
Restart=on-failure
RestartSec=5s
ExecReload=/usr/bin/kill -HUP $MAINPID

[Install]
WantedBy=default.target
