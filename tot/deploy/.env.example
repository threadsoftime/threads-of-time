# Threads of Time operator environment — subset gating (Plan 3).
# Plan 5 will add the full env surface (LLM URL, harness bearer, MySQL creds, etc.)
# at tot/deploy/.env.example when the reference deploy stack lands.

# === Subset gating (Plan 3) ===
TOT_SUBSET_GATE_ENABLED=true
TOT_LIVING_BOT_COUNT=10                 # range 5-15
TOT_SUBSET_RECOMPUTE_INTERVAL_S=60
TOT_SUBSET_HYSTERESIS_OUT_TICKS=2
TOT_SUBSET_HYSTERESIS_IN_TICKS=1
TOT_SUBSET_ENROLL_BACKOFF_S=300
TOT_REDUCED_TICK_INTERVAL_S=300         # REDUCED-tier tick interval (Phase B)
