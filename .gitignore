# ==================
#
#  CUSTOM
#
#  put below your custom ignore rules
#  for example , if you want to include a
#  module directly in repositoryyou can do:
#
#  !modules/yourmodule
#
# ==================

# === Threads of Time additions ===
# Build artifacts
/build/
release-artifacts/
release-artifacts.prev-*/

# Sidecar dev artifacts
tot/*/__pycache__/
tot/*/.pytest_cache/
tot/*/*.egg-info/
tot/*/.venv/

# Python build artifacts (any module client recipe / tests)
__pycache__/
.pytest_cache/

# Local operator state
secrets/
data/

# Editor / OS noise
.DS_Store
*.swp
.vscode/
.idea/

# Logs
*.log

# === ToT-owned modules (override AC's /modules/* exclusion) ===
# AC's stock .gitignore excludes /modules/* assuming operators install modules there.
# ToT FORKS AC and owns these modules — they're tracked in this repo.
!/modules/mod-agenticbots/
!/modules/mod-bracket-sets/
!/modules/mod-harness-bridge/
!/modules/mod-rotation-mode/
!/modules/mod-warforged/

# Internal development artifacts — kept locally, not published (maintainer build notes)
/docs/superpowers/
/FOUNDATION_STATE.md
/MEMORY_SUBSYSTEM_STATE.md
/MPQ_COMPOSITOR_STATE.md
/SUBSET_GATING_STATE.md
/SUBSET_GATING_IN_GAME_TEST.md
/OPERATOR_INSTALL_STATE.md

# Rust build artifacts
/tot/target/
